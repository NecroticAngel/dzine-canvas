# Browser URL for the local template API.
# In production with BASE_PATH, point this at the /api mount (e.g. https://host/canvas/api).
API_ENDPOINT=http://127.0.0.1:4201/api

# Optional Google Web Fonts API key. Leave empty to disable remote font loading.
FONT_API_KEY=

# API listen (production defaults to 0.0.0.0)
# HOST=0.0.0.0
# PORT=4201
# BASE_PATH=

# ---------------------------------------------------------------------------
# Storage paths (for per-user spaces / SA deploy)
# ---------------------------------------------------------------------------
# Root for templates + users/{userId}/designs|uploads (default: api/data)
# STORAGE_ROOT=/var/necrozine/storage
# NECROZINE_STORAGE_ROOT=/var/necrozine/storage

# Optional absolute overrides (win over STORAGE_ROOT children).
# Use {userId} in designs/uploads paths for multi-tenant layout.
# NECROZINE_TEMPLATES_DIR=/var/necrozine/templates
# TEMPLATES_DIR=/var/necrozine/templates
# NECROZINE_PUBLIC_DIR=/var/necrozine/public
# NECROZINE_DESIGNS_DIR=/var/necrozine/users/{userId}/designs
# NECROZINE_UPLOADS_DIR=/var/necrozine/users/{userId}/uploads

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# AUTH_MODE=oidc | headers | dev
#   oidc    — the API verifies the caller's signed token itself (recommended)
#   headers — trust identity headers from a proxy that authenticates callers
#   dev     — one fixed local identity; refused when NODE_ENV=production
# Left unset it infers: oidc when OIDC_ISSUER is set, otherwise dev outside
# production. In production with nothing configured the server refuses to start.
# AUTH_MODE=oidc

# Your identity provider. Any provider works — only discovery and audience matter.
# OIDC_ISSUER=https://id.example.com/realms/clients
# OIDC_JWKS_URL=https://id.example.com/realms/clients/protocol/openid-connect/certs
# OIDC_AUDIENCE=dzine-canvas
# Header the token arrives in (default: authorization, as "Bearer <token>")
# AUTH_TOKEN_HEADER=authorization
# Only for providers signing with HS256/384/512 instead of a JWKS
# OIDC_HMAC_SECRET=

# headers mode only: which headers carry the identity, plus the acknowledgement
# that the API is reachable *only* through that authenticating proxy.
# AUTH_USER_HEADER=x-auth-request-user
# AUTH_EMAIL_HEADER=x-auth-request-email
# AUTH_NAME_HEADER=x-auth-request-name
# AUTH_TRUST_PROXY_HEADERS_ACK=true

# Our own staff. Logins with these emails become admins in the staff tenant on
# first sign-in. Everyone else is invite-only and is rejected until invited.
# AUTH_ADMIN_EMAILS=you@d-zine.org.za
# AUTH_STAFF_TENANT=staff

# dev mode only
# AUTH_DEV_TENANT=default
# AUTH_DEV_USER=dev-user
# AUTH_DEV_EMAIL=dev@localhost

# Clock-skew allowance when checking exp/nbf, in seconds (default 60)
# AUTH_CLOCK_LEEWAY_SECONDS=60

# Comma-separated browser origins allowed to call the API. Unset reflects any
# origin, which is convenient locally and wrong for a deployment.
# CORS_ORIGINS=https://canvas.d-zine.org.za
