.DS_Store

.env
.env.*
!.env.example
*.local

node_modules/
dist/
coverage/
.vite/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.idea/
.vscode/

# Runtime storage: the metadata DB and per-tenant designs/uploads are state, not source.
api/data/db.sqlite*
api/data/users/

# Template previews are copied in from the packaged assets on first boot, so the
# JSON payloads next to them are source but these are not.
api/data/templates/thumbs/

# Generated exports (a 58 MB version of output-from-templates.pdf sits in history).
output-*.pdf

# Storage backups (scripts/backup-storage.mjs). Point --out at another volume in
# production; this ignore is for the local default.
backups/
